{
  "apphosting": [
    {
      "backendId": "crossward-frontend",
      "rootDir": "frontend",
      "ignore": [
        "backend",
        "docs",
        "fixtures",
        "scripts",
        "test",
        ".firebase",
        ".agentic_pipeline_tmp",
        "*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "apphosting": {
      "host": "127.0.0.1",
      "port": 5002,
      "rootDirectory": "frontend",
      "startCommand": "npm run dev"
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "singleProjectMode": true
  }
}
